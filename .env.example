# StreamlineTax Environment Configuration
# Copy this file to .env and fill in the values

# JWT Settings
JWT_KEY=your-secret-key-at-least-32-characters-long

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamline_tax
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# SMTP (SendGrid or other provider)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@yourdomain.com

# OCR.space API Key (optional - falls back to Tesseract)
OCRSPACE_API_KEY=your-ocrspace-api-key

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:4200
